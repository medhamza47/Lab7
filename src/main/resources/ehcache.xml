<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd">

    <!-- Regions des entites (les alias correspondent au nom complet des classes) -->
    <cache alias="com.example.model.Auteur">
        <expiry>
            <ttl unit="minutes">60</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache>

    <cache alias="com.example.model.Livre">
        <expiry>
            <ttl unit="minutes">60</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache>

    <!-- Region de la collection Auteur.livres -->
    <cache alias="com.example.model.Auteur.livres">
        <expiry>
            <ttl unit="minutes">60</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache>

    <!-- Regions internes utilisees par Hibernate (noms par defaut Hibernate 5.4) -->
    <cache alias="default-update-timestamps-region">
        <resources>
            <heap unit="entries">10000</heap>
        </resources>
    </cache>

    <cache alias="default-query-results-region">
        <resources>
            <heap unit="entries">10000</heap>
        </resources>
    </cache>

    <!-- Template utilise pour les regions non declarees ci-dessus -->
    <cache-template name="default">
        <expiry>
            <ttl unit="minutes">60</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache-template>

</config>